{
  "name": "Read Aloud Controls for ChatGPT",
  "version": "0.2.0",
  "description": "Adds a floating player with seek, speed, skip, theme, and download controls for ChatGPT Read Aloud.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/js/settings-bridge.js",
        "src/js/auto-read-aloud.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/js/player-settings.js",
        "src/js/aac-container.js",
        "src/js/media-timeline.js",
        "src/js/captured-playback.js",
        "src/js/content-script.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "manifest_version": 3,
  "permissions": [
    "storage"
  ],
  "short_name": "Read Aloud Controls"
}
